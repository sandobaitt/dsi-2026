@startuml cu_biblioteca
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam actorStyle awesome

' ==============================================================================
' DIAGRAMA DE CASOS DE USO: BiblioUTN (Ejercicio Extra 2026 - Ejercicio 1)
' - Actores a la izquierda inician los CU; el actor externo va a la derecha.
' - Los CU van dentro del límite del sistema; los actores, afuera.
' - Asociaciones sin flechas.
' - El estudiante no es actor: no usa la aplicación, el bibliotecario opera
'   el sistema en el mostrador.
' - <<include>>: Registrar Préstamo y Renovar Préstamo incluyen Validar Condición
'   Regular (parte obligatoria y común). La flecha apunta al CU incluido y el
'   Sistema de Alumnado se asocia a ese CU incluido.
' ==============================================================================

actor "Bibliotecario" as Biblio
actor "Administrativo" as Admin
actor "Sistema de Alumnado" as Alumnado <<Sistema Externo>>

rectangle "BiblioUTN" {
    usecase "Registrar Préstamo" as CU01
    usecase "Registrar Devolución" as CU02
    usecase "Renovar Préstamo" as CU03
    usecase "Registrar Bibliotecario" as CU04
    usecase "Administrar Catálogo de Libros" as CU05
    usecase "Registrar Ejemplar" as CU06
    usecase "Validar Condición Regular" as CU07

    CU01 ..> CU07 : <<include>>
    CU03 ..> CU07 : <<include>>
}

Biblio -- CU01
Biblio -- CU02
Biblio -- CU03

Admin -- CU04
Admin -- CU05
Admin -- CU06

CU07 -- Alumnado

@enduml
