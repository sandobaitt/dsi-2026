@startuml secuencia_armar_hoja_de_ruta
!pragma layout smetana
autonumber
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' DIAGRAMA DE SECUENCIA: Realización de CU "Armar Hoja de Ruta" (Camino Estándar)
' Modelo 03: Fábrica de Muebles Metálicos - Materia: Diseño de Sistemas (DSI 2026)
' - Solo camino estándar de la descripción del CU
' - Sin CTRLSesion: el CU no necesita datos del usuario logueado
' - Recorridos hechos por Sistema: LTP (Pedidos), LTLP (Lineas_pedido), LTTAR (Tareas)
'   Tareas empieza con T -> abreviatura TAR para no confundir con el prefijo LTT.
' - Lista temporal LTTM (muebles de pedidos pendientes) creada y destruida por Sistema
' - Búsqueda indexada del mueble seleccionado (sin loop)
' - Los getters devuelven el objeto; comparaciones por atributo en la guarda
' - El CTRL destruye la UI al finalizar
' ==============================================================================

actor "Jefe de Taller" as Actor
boundary "UISolHR" as UI <<Boundary>>
control "CTRLSolHR" as CTRL <<Control>>
participant "Sistema" as Sistema <<Sistema>>
participant "LTP: Pedidos" as LTP <<Entity>>
participant "LTLP: Lineas_pedido" as LTLP <<Entity>>
participant "Muebles" as Muebles <<Entity>>
participant "m: Mueble" as Mueble <<Entity>>
participant "pt: Plantilla_tarea" as Plantilla <<Entity>>
participant "LTTAR: Tareas" as LTTAR <<Entity>>
participant "LTTM: Muebles" as LTTM
participant "hr: HojaDeRuta" as HojaDeRuta <<Entity>>

== Paso 1: El Jefe de Taller solicita armar la hoja de ruta ==
Actor -> UI: solicitarArmadoHR()
activate UI
UI -> CTRL: iniciarArmadoHR()
activate CTRL

== Paso 2: El sistema busca y muestra los muebles de los pedidos pendientes ==
CTRL -> Sistema: obtenerMueblesPedidosPendientes()
activate Sistema

create LTTM
Sistema -> LTTM: create()

loop for each p in LTP
    Sistema -> LTP: getPedido()
    activate LTP
    LTP --> Sistema: p
    deactivate LTP

    opt p.estado = pendiente
        Sistema -> LTP: getLineasPedido()
        activate LTP
        LTP --> Sistema: LTLP
        deactivate LTP

        loop for each lp in LTLP
            Sistema -> LTLP: getMueble()
            activate LTLP
            LTLP --> Sistema: m
            deactivate LTLP
            Sistema -> LTTM: add(m)
        end
    end
end

Sistema --> CTRL: LTTM
Sistema -> LTTM: destroy()
destroy LTTM
deactivate Sistema

CTRL -> UI: mostrarMuebles(LTTM)
UI --> Actor: muebles de los pedidos pendientes

== Paso 3: El Jefe de Taller selecciona el mueble ==
Actor -> UI: seleccionarMueble(idMueble)
UI -> CTRL: tomarMueble(idMueble)

== Paso 4: El sistema carga las tareas estándar, calcula el tiempo total y muestra la vista previa ==
CTRL -> Sistema: obtenerVistaPreviaHR(idMueble)
activate Sistema

Sistema -> Muebles: getMueble(idMueble)
activate Muebles
Muebles --> Sistema: m
deactivate Muebles

Sistema -> Mueble: getPlantillaTarea()
activate Mueble
Mueble --> Sistema: pt
deactivate Mueble

Sistema -> Plantilla: getTareas()
activate Plantilla
Plantilla --> Sistema: LTTAR
deactivate Plantilla

Sistema -> Sistema: calcularTiempoTotal(LTTAR)
activate Sistema
loop for each ta in LTTAR (tiempoTotal += ta.duracionEstimada)
    Sistema -> LTTAR: getTarea()
    activate LTTAR
    LTTAR --> Sistema: ta
    deactivate LTTAR
end
deactivate Sistema

Sistema --> CTRL: LTTAR, tiempoTotal
deactivate Sistema

CTRL -> UI: mostrarVistaPreviaHR(LTTAR, tiempoTotal)
UI --> Actor: tareas estándar con sus duraciones y tiempo total estimado

== Paso 5: El Jefe de Taller confirma la hoja de ruta ==
Actor -> UI: confirmarHR()
UI -> CTRL: tomarConfirmacion()

== Paso 6: El sistema registra la hoja de ruta y emite las copias ==
CTRL -> Sistema: registrarHR(idMueble, tiempoTotal)
activate Sistema

create HojaDeRuta
Sistema -> HojaDeRuta: create(m, tiempoTotal)

loop for each ta in LTTAR
    Sistema -> HojaDeRuta: agregarTarea(ta)
end

Sistema --> CTRL: hr
deactivate Sistema

CTRL -> UI: imprimirHR(hr)
UI --> Actor: copias impresas de la hoja de ruta

CTRL -> UI: destroy()
destroy UI
deactivate CTRL

@enduml
