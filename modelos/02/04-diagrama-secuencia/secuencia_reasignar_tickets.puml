@startuml secuencia_reasignar_tickets
!pragma layout smetana
autonumber "<b>[00]</b>"
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' REALIZACIÓN DEL CASO DE USO: Reasignar Tickets por Ausencia de Desarrollador
' Aplicación: DevTrack (NubeSoft) - Cátedra: Diseño de Sistemas (DSI 2026)
' 
' REGLAS DE ORO DE CÁTEDRA APLICADAS:
' 1. CTRLSesion preexistente (entre CTRLCU y Sistema) provee el liderActivo.
' 2. UI y CTRLCU sin atributos. Métodos con parámetros tipados explícitos.
' 3. Sistema interactúa con la entidad liderActivo (nunca con el Actor humano).
' 4. Listas temporales creadas con create() y finalizadas con destroy.
' 5. Trello como Actor Externo ubicado a la derecha con comunicación asíncrona (->>).
' 6. Patrón Experto: Equipo y Desarrollador colaboran para calcular la carga del sprint.
' 7. Creación de la entidad transaccional Reasignacion para auditoría e historial.
' 8. Retornos en línea discontinua sin la palabra "return".
' ==============================================================================

' ------------------------------------------------------------------------------
' 1. PARTICIPANTES (Orden estricto de izquierda a derecha)
' ------------------------------------------------------------------------------
actor "Líder Técnico" as Actor
boundary "PantallaReasignarTickets" as UI <<Boundary>>
control "CTRLReasignarTickets" as CTRLCU <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
entity "liderActivo" as Lider <<Entity>>
entity "equipoLider" as Equipo <<Entity>>
collections "Ticket" as Tickets <<Entity>>
collections "Desarrollador" as Devs <<Entity>>
entity "listaTicketsActivos" as TempActivos <<Lista Temporal>>
entity "listaTicketsCandidatos" as TempCandidatos <<Lista Temporal>>
entity "listaDevsCarga" as TempDevs <<Lista Temporal>>
entity "ticketSeleccionado" as Ticket <<Entity>>
entity "nuevaReasignacion" as Reasignacion <<Entity>>
actor "Trello" as Trello <<Actor Externo>>

' ------------------------------------------------------------------------------
' CAMINO ESTÁNDAR (Alineado estrictamente a los 13 pasos oficiales del enunciado)
' ------------------------------------------------------------------------------

== Paso 1 y 2: Selección de la opción del caso de uso ==
Actor -> UI: 1. solicitarOpciones()
activate UI
UI --> Actor: 2. mostrarMenuOpciones()

Actor -> UI: 3. seleccionarReasignarTicketsAusencia()
UI -> CTRLCU: 4. iniciarReasignacionAusencia()
activate CTRLCU

' Recuperación de credenciales del usuario autenticado sin solicitar datos al actor
CTRLCU -> CTRLSesion: 5. obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRLCU: 6. liderActivo
deactivate CTRLSesion

== Paso 3: El sistema muestra la lista de desarrolladores del equipo ==
CTRLCU -> Sistema: 7. obtenerDesarrolladoresEquipo(liderActivo)
activate Sistema

' Se consulta a la entidad LiderTecnico del dominio, no al Actor humano
Sistema -> Lider: 8. getEquipo()
activate Lider
Lider --> Sistema: 9. equipoLider
deactivate Lider

Sistema -> Equipo: 10. getDesarrolladores()
activate Equipo
Equipo --> Sistema: 11. desarrolladoresEquipo
deactivate Equipo

Sistema --> CTRLCU: 12. desarrolladoresEquipo
deactivate Sistema

CTRLCU --> UI: 13. mostrarListaDesarrolladores(desarrolladoresEquipo)
UI --> Actor: 14. Despliega nómina de desarrolladores del equipo

== Paso 4: Selección del desarrollador que se ausenta ==
Actor -> UI: 15. seleccionarDesarrolladorAusente(idDesarrollador)
UI -> CTRLCU: 16. buscarTicketsCandidatos(idDesarrollador)

== Paso 5: Búsqueda de tickets activos del desarrollador ==
CTRLCU -> Sistema: 17. obtenerTicketsActivos(idDesarrollador)
activate Sistema

create TempActivos
Sistema -> TempActivos: 18. create()

loop para cada ticket en ticketsRegistrados
    Sistema -> Tickets: 19. esDeDesarrolladorYActivo(idDesarrollador)
    activate Tickets
    Tickets --> Sistema: 20. esActivo
    deactivate Tickets

    opt esActivo == true
        Sistema -> TempActivos: 21. add(ticket)
    end
end

Sistema --> CTRLCU: 22. listaTicketsActivos
deactivate Sistema

== Paso 6: Validación contra Trello y obtención de tickets candidatos ==
create TempCandidatos
Sistema -> TempCandidatos: 23. create()

loop para cada ticket en listaTicketsActivos
    ' Mensaje asíncrono con flecha abierta hacia ACTOR EXTERNO
    CTRLCU ->> Trello: 24. consultarEstadoTarjeta(idTarjetaTrello)
    activate Trello
    Trello -->> CTRLCU: 25. columnaTarjeta ("En progreso")
    deactivate Trello

    opt columnaTarjeta != "Hecho"
        CTRLCU -> Sistema: 26. agregarTicketCandidato(ticket)
        activate Sistema
        Sistema -> TempCandidatos: 27. add(ticket)
        deactivate Sistema
    end
end

' Fin del ciclo de vida de la lista temporal intermedia de tickets activos
destroy TempActivos

CTRLCU -> Sistema: 28. obtenerTicketsCandidatos()
activate Sistema
Sistema --> CTRLCU: 29. listaTicketsCandidatos
deactivate Sistema

CTRLCU --> UI: 30. mostrarTicketsCandidatos(listaTicketsCandidatos)
UI --> Actor: 31. Despliega tickets candidatos a reasignación

== Pasos 7 a 12: Bucle de reasignación de tickets (repite según pasos 9 a 13 del enunciado) ==
loop mientras existan tickets pendientes y el Líder continúe reasignando
    == Paso 7: Selección de ticket a reasignar ==
    Actor -> UI: 32. seleccionarTicketAReasignar(idTicket)

    == Paso 8: El sistema muestra lista de desarrolladores disponibles y su carga ==
    UI -> CTRLCU: 33. solicitarDesarrolladoresDisponibles(idTicket)

    CTRLCU -> Sistema: 34. obtenerDesarrolladoresConCarga(equipoLider)
    activate Sistema

    Sistema -> Equipo: 35. obtenerDesarrolladoresConCarga()
    activate Equipo

    create TempDevs
    Equipo -> TempDevs: 36. create()

    ' Patrón Experto: cada desarrollador calcula su propia carga para el sprint
    loop para cada desarrollador en el equipo
        Equipo -> Devs: 37. calcularCargaSprint()
        activate Devs
        Devs --> Equipo: 38. cargaHoras
        deactivate Devs
        Equipo -> TempDevs: 39. add(desarrollador, cargaHoras)
    end

    Equipo --> Sistema: 40. listaDevsConCarga
    deactivate Equipo

    ' Destrucción de la lista temporal de cálculo de carga de desarrolladores
    destroy TempDevs

    Sistema --> CTRLCU: 41. listaDevsConCarga
    deactivate Sistema

    CTRLCU --> UI: 42. mostrarDesarrolladoresDisponibles(listaDevsConCarga)
    UI --> Actor: 43. Despliega desarrolladores disponibles con su carga de trabajo en el sprint

    == Paso 9: Selección del nuevo desarrollador para el ticket ==
    Actor -> UI: 44. seleccionarNuevoDesarrollador(idTicket, idNuevoDev)

    UI -> CTRLCU: 45. confirmarReasignacion(idTicket, idNuevoDev)

    == Paso 10 y 11: Actualización de ticket y registro de cambio con responsable y fecha ==
    CTRLCU -> Sistema: 46. registrarReasignacion(idTicket, idNuevoDev, liderActivo)
    activate Sistema

    ' Se recupera el dev anterior para trazabilidad histórica
    Sistema -> Ticket: 47. getDesarrolladorAsignado()
    activate Ticket
    Ticket --> Sistema: 48. devAnterior

    ' Actualización de la asignación del ticket (Paso 10)
    Sistema -> Ticket: 49. setDesarrolladorAsignado(nuevoDev)
    Ticket --> Sistema: 50. confirmacion
    deactivate Ticket

    ' Instanciación de la entidad transaccional e histórica Reasignacion (Paso 11)
    create Reasignacion
    Sistema -> Reasignacion: 51. create(ticket, devAnterior, nuevoDev, liderActivo, fechaHora)
    Sistema -> Sistema: 52. agregarReasignacion(nuevaReasignacion)

    Sistema --> CTRLCU: 53. confirmacion
    deactivate Sistema

    CTRLCU --> UI: 54. notificarReasignacionExitosa()
    UI --> Actor: 55. Muestra confirmación de reasignación efectuada
end

== Paso 13: El sistema muestra un resumen de los tickets reasignados ==
Actor -> UI: 56. finalizarReasignacion()
UI -> CTRLCU: 57. solicitarResumenReasignaciones()

CTRLCU -> Sistema: 58. obtenerResumenReasignaciones()
activate Sistema
Sistema --> CTRLCU: 59. listaResumen
deactivate Sistema

' Destrucción de la lista temporal de tickets candidatos al finalizar el proceso
destroy TempCandidatos

CTRLCU --> UI: 60. mostrarResumenReasignados(listaResumen)
deactivate CTRLCU

UI --> Actor: 61. Despliega resumen consolidado de los tickets reasignados
deactivate UI

@enduml
