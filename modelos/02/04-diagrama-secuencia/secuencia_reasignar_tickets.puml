@startuml secuencia_reasignar_tickets
!pragma layout smetana
autonumber
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' REALIZACIÓN DEL CASO DE USO: Reasignar Tickets por Ausencia de Desarrollador
' Aplicación: DevTrack (NubeSoft) - Cátedra: Diseño de Sistemas (DSI 2026)
'
' REGLAS DE CÁTEDRA APLICADAS:
' - Solo camino estándar. El paso 1 (menú de opciones) es previo a la selección.
' - CTRLSesion preexistente provee el líder logueado.
' - Los loops los hace el Sistema (LTTIC: Tickets, LTD: Desarrolladores, LTR: Reasignaciones).
'   Tickets empieza con T -> abreviatura TIC para no confundir con el prefijo LTT.
' - Listas temporales LTTTIC / LTTD / LTTR creadas, llenadas y destruidas por Sistema.
' - Trello es actor externo invocado por Sistema con mensaje asíncrono.
' - Comparaciones por atributo en la guarda, sin getters extra.
' - Cambio de asignación con mensaje de negocio t.reasignar(nuevoDev).
' - El CTRL destruye la UI al finalizar.
' ==============================================================================

actor "Líder Técnico" as Actor
boundary "PantallaReasignarTickets" as UI <<Boundary>>
control "CTRLReasignarTickets" as CTRLCU <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
participant "lider: LiderTecnico" as Lider <<Entity>>
participant "eq: Equipo" as Equipo <<Entity>>
participant "LTD: Desarrolladores" as LTD <<Entity>>
participant "LTTIC: Tickets" as LTTIC <<Entity>>
participant "t: Ticket" as Ticket <<Entity>>
participant "LTR: Reasignaciones" as LTR <<Entity>>
participant "LTTTIC: Tickets" as LTTTIC
participant "LTTD: Desarrolladores" as LTTD
participant "rea: Reasignacion" as Reasignacion <<Entity>>
participant "LTTR: Reasignaciones" as LTTR
actor "Trello" as Trello

== Pasos 1 y 2: El líder selecciona la opción "Reasignar tickets por ausencia" ==
Actor -> UI: seleccionarOpcionReasignar()
activate UI
UI -> CTRLCU: iniciarReasignacion()
activate CTRLCU

CTRLCU -> CTRLSesion: obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRLCU: lider
deactivate CTRLSesion

== Paso 3: El sistema muestra la lista de desarrolladores del equipo ==
CTRLCU -> Sistema: obtenerDesarrolladoresEquipo(lider)
activate Sistema
Sistema -> Lider: getEquipo()
activate Lider
Lider --> Sistema: eq
deactivate Lider
Sistema -> Equipo: getDesarrolladores()
activate Equipo
Equipo --> Sistema: LTD
deactivate Equipo
Sistema --> CTRLCU: LTD
deactivate Sistema

CTRLCU -> UI: mostrarDesarrolladores(LTD)
UI --> Actor: desarrolladores del equipo

== Paso 4: El líder selecciona el desarrollador que se ausenta ==
Actor -> UI: seleccionarDesarrolladorAusente(idDevAusente)
UI -> CTRLCU: tomarDesarrolladorAusente(idDevAusente)

== Pasos 5 y 6: El sistema busca los tickets activos del desarrollador y los valida contra Trello ==
CTRLCU -> Sistema: obtenerTicketsCandidatos(idDevAusente)
activate Sistema

create LTTTIC
Sistema -> LTTTIC: create()

loop for each t in LTTIC
    Sistema -> LTTIC: getTicket()
    activate LTTIC
    LTTIC --> Sistema: t
    deactivate LTTIC

    opt t.desarrollador.id = idDevAusente y t.estado = abierto o en progreso
        Sistema ->> Trello: obtenerColumnaTarjeta(t.idTarjetaTrello)
        activate Trello
        Trello --> Sistema: columna
        deactivate Trello

        opt columna <> "Hecho"
            Sistema -> LTTTIC: add(t)
        end
    end
end

Sistema --> CTRLCU: LTTTIC
Sistema -> LTTTIC: destroy()
destroy LTTTIC
deactivate Sistema

CTRLCU -> UI: mostrarTicketsCandidatos(LTTTIC)
UI --> Actor: tickets candidatos a reasignación

== Paso 12: Se repiten los pasos 7 a 11 hasta que el líder decide finalizar ==
loop mientras el líder no finalice la reasignación

    == Paso 7: El líder selecciona un ticket de la lista ==
    Actor -> UI: seleccionarTicket(idTicket)
    UI -> CTRLCU: tomarTicket(idTicket)

    == Paso 8: El sistema muestra los desarrolladores disponibles con su carga del sprint ==
    CTRLCU -> Sistema: obtenerDesarrolladoresDisponibles(lider, idDevAusente)
    activate Sistema
    Sistema -> Lider: getEquipo()
    activate Lider
    Lider --> Sistema: eq
    deactivate Lider
    Sistema -> Equipo: getDesarrolladores()
    activate Equipo
    Equipo --> Sistema: LTD
    deactivate Equipo

    create LTTD
    Sistema -> LTTD: create()

    loop for each d in LTD
        Sistema -> LTD: getDesarrollador()
        activate LTD
        LTD --> Sistema: d
        deactivate LTD

        opt d.id <> idDevAusente
            ' Patrón experto: cada desarrollador calcula su carga del sprint vigente
            Sistema -> LTD: calcularCargaSprint()
            activate LTD
            LTD --> Sistema: carga
            deactivate LTD
            Sistema -> LTTD: add(d, carga)
        end
    end

    Sistema --> CTRLCU: LTTD
    Sistema -> LTTD: destroy()
    destroy LTTD
    deactivate Sistema

    CTRLCU -> UI: mostrarDesarrolladoresDisponibles(LTTD)
    UI --> Actor: desarrolladores disponibles con su carga

    == Paso 9: El líder selecciona el nuevo desarrollador ==
    Actor -> UI: seleccionarNuevoDesarrollador(idNuevoDev)
    UI -> CTRLCU: tomarNuevoDesarrollador(idNuevoDev)

    == Pasos 10 y 11: El sistema actualiza el ticket y registra el cambio con responsable y fecha ==
    CTRLCU -> Sistema: reasignarTicket(idTicket, idNuevoDev, lider)
    activate Sistema

    ' Búsquedas indexadas: un objeto puntual conocido por su id
    Sistema -> LTTIC: getTicket(idTicket)
    activate LTTIC
    LTTIC --> Sistema: t
    deactivate LTTIC
    Sistema -> LTD: getDesarrollador(idNuevoDev)
    activate LTD
    LTD --> Sistema: nuevoDev
    deactivate LTD

    ' Cambio de asignación con mensaje de negocio (el ticket actualiza su propio estado)
    Sistema -> Ticket: reasignar(nuevoDev)
    activate Ticket
    Ticket --> Sistema: devAnterior
    deactivate Ticket

    create Reasignacion
    Sistema -> Reasignacion: create(t, devAnterior, nuevoDev, lider, fechaHoraActual)

    Sistema --> CTRLCU: rea
    deactivate Sistema

    CTRLCU -> UI: mostrarReasignacionRegistrada(rea)
    UI --> Actor: reasignación registrada
end

== Paso 13: El sistema muestra un resumen de los tickets reasignados ==
Actor -> UI: finalizarReasignacion()
UI -> CTRLCU: tomarFinalizacion()

CTRLCU -> Sistema: obtenerResumenReasignaciones(lider, idDevAusente, fechaActual)
activate Sistema

create LTTR
Sistema -> LTTR: create()

loop for each r in LTR
    Sistema -> LTR: getReasignacion()
    activate LTR
    LTR --> Sistema: r
    deactivate LTR

    opt r.lider = lider y r.devAnterior.id = idDevAusente y r.fecha = fechaActual
        Sistema -> LTTR: add(r)
    end
end

Sistema --> CTRLCU: LTTR
Sistema -> LTTR: destroy()
destroy LTTR
deactivate Sistema

CTRLCU -> UI: mostrarResumen(LTTR)
UI --> Actor: resumen de tickets reasignados

CTRLCU -> UI: destroy()
destroy UI
deactivate CTRLCU

@enduml
