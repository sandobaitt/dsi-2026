@startuml clases_reasignar_tickets
!pragma layout smetana
skinparam shadowing false
skinparam roundcorner 8
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ==============================================================================
' DIAGRAMA DE CLASES: Realización de CU "Reasignar Tickets por Ausencia"
' Aplicación: DevTrack (NubeSoft) - Cátedra: Diseño de Sistemas (DSI 2026)
'
' REGLAS DE CÁTEDRA APLICADAS:
' - Se incluyen ÚNICAMENTE las clases involucradas en el caso de uso.
' - UI y Controladores (CTRL, CTRLSesion) NO LLEVAN ATRIBUTOS.
' - Clases de dominio con atributos privados (-) y métodos públicos (+).
' - Tipado explícito en todos los parámetros y retornos.
' - Coherencia con los mensajes del Diagrama de Secuencia (verificar.py).
' ==============================================================================

package "Capa de Presentación y Control" {

    ' UI: Sin atributos. Responsable de interacción con el Líder Técnico.
    class "PantallaReasignarTickets" as UI <<Boundary>> {
        + seleccionarOpcionReasignar(): void
        + mostrarDesarrolladores(desarrolladores: List): void
        + seleccionarDesarrolladorAusente(idDevAusente: int): void
        + mostrarTicketsCandidatos(candidatos: List): void
        + seleccionarTicket(idTicket: int): void
        + mostrarDesarrolladoresDisponibles(disponibles: List): void
        + seleccionarNuevoDesarrollador(idNuevoDev: int): void
        + mostrarReasignacionRegistrada(rea: Reasignacion): void
        + finalizarReasignacion(): void
        + mostrarResumen(reasignaciones: List): void
    }

    ' Controlador del CU: Sin atributos. Coordina el flujo del CU.
    class "CTRLReasignarTickets" as CTRLCU <<Control>> {
        + iniciarReasignacion(): void
        + tomarDesarrolladorAusente(idDevAusente: int): void
        + tomarTicket(idTicket: int): void
        + tomarNuevoDesarrollador(idNuevoDev: int): void
        + tomarFinalizacion(): void
    }

    ' Controlador de Sesión: Sin atributos. Provee la entidad del Líder activo.
    class "CTRLSesion" as CTRLSesion <<Control>> {
        + obtenerUsuarioLogueado(): LiderTecnico
    }

    ' Sistema: Fachada de negocio. Conoce colecciones, recorre y consulta a Trello.
    class "Sistema" as Sistema <<Sistema>> {
        + obtenerDesarrolladoresEquipo(lider: LiderTecnico): List
        + obtenerTicketsCandidatos(idDevAusente: int): List
        + obtenerDesarrolladoresDisponibles(lider: LiderTecnico, idDevAusente: int): List
        + reasignarTicket(idTicket: int, idNuevoDev: int, lider: LiderTecnico): Reasignacion
        + obtenerResumenReasignaciones(lider: LiderTecnico, idDevAusente: int, fechaActual: Date): List
    }
}

package "Capa de Dominio" {

    class "LiderTecnico" as LiderTecnico <<Entity>> {
        - idLider: int
        - nombre: String
        - apellido: String
        - email: String
        + getEquipo(): Equipo
    }

    class "Equipo" as Equipo <<Entity>> {
        - idEquipo: int
        - nombre: String
        + getDesarrolladores(): List
    }

    class "Desarrollador" as Desarrollador <<Entity>> {
        - idDesarrollador: int
        - nombre: String
        - apellido: String
        - email: String
        + calcularCargaSprint(): int
    }

    class "Ticket" as Ticket <<Entity>> {
        - idTicket: int
        - descripcion: String
        - prioridad: String
        - estado: String
        - idTarjetaTrello: String
        + reasignar(nuevoDev: Desarrollador): Desarrollador
    }

    ' Clase transaccional e histórica que registra cada cambio de asignación
    class "Reasignacion" as Reasignacion <<Entity>> {
        - idReasignacion: int
        - fechaHora: DateTime
        - motivo: String
    }
}

' ------------------------------------------------------------------------------
' RELACIONES
' ------------------------------------------------------------------------------

' Flujo de Control y Dependencias
UI ..> CTRLCU : invoca eventos >
CTRLCU --> CTRLSesion : consulta sesión >
CTRLCU --> Sistema : delega operaciones >

' Sistema administra y conoce las colecciones globales
Sistema o-- "*" Ticket : ticketsRegistrados
Sistema o-- "*" Equipo : equiposRegistrados
Sistema o-- "*" Reasignacion : reasignacionesRegistradas

' Relaciones estructurales del Dominio
Equipo "1" -- "1" LiderTecnico : liderado por >
Equipo "1" o-- "1..*" Desarrollador : conformado por >
Ticket "*" --> "1" Desarrollador : asignado a >

' Relaciones de la Clase Transaccional Reasignacion
Reasignacion "*" --> "1" Ticket : transfiere >
Reasignacion "*" --> "1" LiderTecnico : ejecutada por >
Reasignacion "*" --> "1" Desarrollador : devAnterior >
Reasignacion "*" --> "1" Desarrollador : devNuevo >

note bottom of Reasignacion
  **Clase Transaccional e Histórica:**
  Registra la trazabilidad de cada
  reasignación con fecha, responsable y desarrolladores.
end note

note right of Sistema
  **Actor externo Trello:** el Sistema le envía
  obtenerColumnaTarjeta(idTarjetaTrello) con un
  mensaje asíncrono. No se modela como clase.
end note

@enduml
