@startuml secuencia_realizar_reserva
!pragma layout smetana
autonumber
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' DIAGRAMA DE SECUENCIA: Realización de CU "Realizar Reserva" (Reserva Paga)
' Aplicación: Artify - Materia: Diseño de Sistemas (DSI 2026)
' - Solo camino estándar de la descripción del CU
' - Búsqueda indexada del evento (sin loop): Eventos.getEvento(idEvento)
' - Entidad Bancaria como actor externo invocado por Sistema (asíncrono)
' - Composición Reserva -> Entrada: la cabecera crea sus entradas
' - Cambio de estado con mensaje de negocio: r.confirmar()
' - CTRL destruye la UI al finalizar
' ==============================================================================

actor "Usuario Registrado" as Actor
boundary "PantallaReserva" as UI <<Boundary>>
control "CTRLRealizarReserva" as CTRL <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
participant "Eventos" as Eventos <<Entity>>
participant "e: Evento" as Evento <<Entity>>
participant "u: Usuario" as Usuario <<Entity>>
participant "r: Reserva" as Reserva <<Entity>>
participant "en: Entrada" as Entrada <<Entity>>
actor "Entidad Bancaria" as Banco

== Paso 1: El usuario solicita reservar indicando cantidad y asientos ==
Actor -> UI: solicitarReserva(idEvento, cantidad, asientos)
activate UI
UI -> CTRL: tomarSolicitudReserva(idEvento, cantidad, asientos)
activate CTRL

CTRL -> CTRLSesion: obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRL: u
deactivate CTRLSesion

== Paso 2: El sistema verifica disponibilidad, calcula el importe y solicita el medio de pago ==
CTRL -> Sistema: verificarDisponibilidad(idEvento, cantidad)
activate Sistema
Sistema -> Eventos: getEvento(idEvento)
activate Eventos
Eventos --> Sistema: e
deactivate Eventos
Sistema -> Evento: tieneDisponibilidad(cantidad)
activate Evento
Evento --> Sistema: disponible
deactivate Evento
Sistema --> CTRL: disponible
deactivate Sistema

CTRL -> Sistema: calcularImporteTotal(idEvento, cantidad)
activate Sistema
Sistema -> Evento: calcularImporte(cantidad)
activate Evento
Evento --> Sistema: importeTotal
deactivate Evento
Sistema --> CTRL: importeTotal
deactivate Sistema

CTRL -> UI: solicitarMedioPago(importeTotal)
UI --> Actor: importe total y medios de pago disponibles

== Paso 3: El usuario selecciona el medio de pago, ingresa los datos y confirma ==
Actor -> UI: ingresarDatosPago(medioPago, datosPago)
UI -> CTRL: tomarDatosPago(medioPago, datosPago)

== Pasos 4 y 5: El sistema solicita la autorización a la entidad financiera y recibe la aprobación ==
CTRL -> Sistema: procesarPago(medioPago, datosPago, importeTotal)
activate Sistema
Sistema ->> Banco: autorizarCobro(medioPago, datosPago, importeTotal)
activate Banco
Banco --> Sistema: pagoAprobado
deactivate Banco
Sistema --> CTRL: pagoAprobado
deactivate Sistema

== Paso 6: El sistema registra la reserva confirmada, descuenta entradas, genera comprobantes y actualiza el calendario ==
CTRL -> Sistema: registrarReserva(u, idEvento, cantidad, asientos, importeTotal)
activate Sistema

create Reserva
Sistema -> Reserva: create(u, e, importeTotal)

loop for each asiento in asientos
    Sistema -> Reserva: agregarEntrada(asiento)
    activate Reserva
    create Entrada
    Reserva -> Entrada: create(asiento)
    deactivate Reserva
end

Sistema -> Reserva: confirmar()
Sistema -> Evento: decrementarCupo(cantidad)
Sistema -> Usuario: agregarAlCalendario(r)

Sistema --> CTRL: r
deactivate Sistema

== Paso 7: El sistema informa el código de confirmación y los detalles de asistencia ==
CTRL -> UI: mostrarReservaConfirmada(r)
UI --> Actor: código de confirmación y detalles de asistencia

CTRL -> UI: destroy()
destroy UI
deactivate CTRL

@enduml
