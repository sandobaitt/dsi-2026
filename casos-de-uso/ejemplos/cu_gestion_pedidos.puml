@startuml cu_gestion_pedidos
!pragma layout smetana
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam actorStyle awesome

' ==============================================================================
' EJEMPLO: Diagrama de Casos de Uso - Módulo de Gestión de Pedidos
' Materia: Diseño de Sistemas (DSI 2026)
' ==============================================================================

left to right direction

' Actores que inician (lado izquierdo)
actor "Cliente" as Cliente
actor "Administrador" as Admin

' Actor secundario / externo (lado derecho)
actor "Pasarela de Pagos" as PasarelaPago <<Sistema Externo>>

' Herencia entre actores
Admin --|> Cliente

rectangle "Sistema de Ventas" {
    
    usecase "Consultar Catalogo" as CU_Catalogo
    usecase "Crear Pedido" as CU_CrearPedido
    usecase "Procesar Pago" as CU_ProcesarPago
    usecase "Aplicar Cupon de Descuento" as CU_Cupon
    usecase "Gestionar Inventario" as CU_Inventario

    ' Relaciones entre Casos de Uso
    ' include: obligatorio para completar Crear Pedido
    CU_CrearPedido ..> CU_ProcesarPago : <<include>>

    ' extend: opcional bajo condición de poseer cupón
    CU_Cupon ..> CU_CrearPedido : <<extend>>
}

' Asociaciones Actor - Caso de Uso (Línea sólida simple SIN flechas)
Cliente -- CU_Catalogo
Cliente -- CU_CrearPedido
Admin -- CU_Inventario

' Asociación con actor secundario (soporte externo, SIN flechas)
CU_ProcesarPago -- PasarelaPago

@enduml
