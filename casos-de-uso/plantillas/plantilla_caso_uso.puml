@startuml plantilla_caso_uso
!pragma layout smetana
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam actorStyle awesome

' ==============================================================================
' PLANTILLA: Diagrama de Casos de Uso (UML - Cátedra DSI 2026)
' ==============================================================================

' ------------------------------------------------------------------------------
' 1. ACTORES
' - Lado izquierdo: Actores que inician el caso de uso (roles, nunca nombres propios).
' - Lado derecho: Sistemas externos de soporte o receptores de información.
' ------------------------------------------------------------------------------
actor "RolUsuario" as ActPrimario
actor "RolAdministrador" as ActAdmin
actor "SistemaExterno" as ActSecundario <<Sistema Externo>>

' Generalización / Herencia entre actores (si aplica)
ActAdmin --|> ActPrimario

' ------------------------------------------------------------------------------
' 2. LÍMITE DEL SISTEMA (System Boundary)
' - Los casos de uso van adentro; los actores van siempre afuera.
' - Nomenclatura del CU: [Verbo en infinitivo] + [Sustantivo]
' ------------------------------------------------------------------------------
rectangle "Nombre del Sistema" {
    
    usecase "Registrar Operacion" as CU01
    usecase "Validar Requisito Comun" as CU02
    usecase "Gestionar Opcion Adicional" as CU03
    usecase "Administrar Configuracion" as CU04

    ' --------------------------------------------------------------------------
    ' 3. RELACIONES ENTRE CASOS DE USO
    ' - <<include>> : Parte obligatoria reutilizada. Flecha hacia el CU incluido.
    ' - <<extend>>  : Comportamiento opcional. Flecha hacia el CU base.
    ' --------------------------------------------------------------------------
    CU01 ..> CU02 : <<include>>
    CU03 ..> CU01 : <<extend>>
}

' ------------------------------------------------------------------------------
' 4. ASOCIACIONES ACTOR - CASO DE USO
' - Regla de oro de cátedra: Línea sólida simple (--). ¡NO LLEVA FLECHAS!
' ------------------------------------------------------------------------------
ActPrimario -- CU01
ActAdmin -- CU04

' Interacción con actor secundario (soporte / externo)
CU01 -- ActSecundario

@enduml
