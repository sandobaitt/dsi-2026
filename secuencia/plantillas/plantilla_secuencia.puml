@startuml plantilla_secuencia
!pragma layout smetana
autonumber
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' PLANTILLA: Diagrama de Secuencia (Cátedra DSI 2026)
' Reglas completas: .agents/skills/dsi-secuencia/SKILL.md
' - Solo camino estándar de la descripción del CU
' - Orden: Actor -> UI -> CTRLCU -> CTRLSesion -> Sistema -> Dominio -> Actor Externo
' - Recorridos LT + inicial (LTC: Clientes), listas temporales LTT + inicial (LTTC)
' - Sistema hace los loops, crea/llena/destruye las listas temporales
' - Actor externo invocado por Sistema con mensaje asíncrono (->>)
' - CTRLCU destruye la UI al final
' - Verificar con: ./verificar.py <carpeta>
' ==============================================================================

actor "Usuario" as Actor
boundary "PantallaOperacion" as UI <<Boundary>>
control "CTRLCasoDeUso" as CTRLCU <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
participant "LTC: Clientes" as LTC <<Entity>>
participant "LTTC: Clientes" as LTTC
participant "n: Nuevo" as Nuevo <<Entity>>
actor "ServicioExterno" as ActorExt

== Paso 1: El actor solicita la operación ==
Actor -> UI: solicitarOperacion()
activate UI
UI -> CTRLCU: iniciarOperacion()
activate CTRLCU

' Solo si el CU necesita al usuario logueado
CTRLCU -> CTRLSesion: obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRLCU: usuario
deactivate CTRLSesion

== Paso 2: El sistema busca y muestra los datos ==
CTRLCU -> Sistema: obtenerClientesActivos()
activate Sistema

create LTTC
Sistema -> LTTC: create()

loop for each c in LTC
    Sistema -> LTC: getCliente()
    activate LTC
    LTC --> Sistema: c
    deactivate LTC

    opt c.estado = activo
        Sistema -> LTTC: add(c)
    end
end

Sistema --> CTRLCU: LTTC
Sistema -> LTTC: destroy()
destroy LTTC
deactivate Sistema

CTRLCU -> UI: mostrarClientes(LTTC)
UI --> Actor: clientes activos

== Paso 3: El actor selecciona y confirma ==
Actor -> UI: seleccionarCliente(idCliente)
UI -> CTRLCU: tomarCliente(idCliente)

== Paso 4: El sistema valida con el tercero y registra ==
CTRLCU -> Sistema: registrarOperacion(usuario, idCliente)
activate Sistema

' Búsqueda indexada (un objeto puntual)
Sistema -> LTC: getCliente(idCliente)
activate LTC
LTC --> Sistema: c
deactivate LTC

Sistema ->> ActorExt: validarConTercero(c)
activate ActorExt
ActorExt --> Sistema: resultadoValidacion
deactivate ActorExt

create Nuevo
Sistema -> Nuevo: create(usuario, c)

Sistema --> CTRLCU: n
deactivate Sistema

== Paso 5: El sistema informa el resultado ==
CTRLCU -> UI: mostrarConfirmacion(n)
UI --> Actor: operación registrada

CTRLCU -> UI: destroy()
destroy UI
deactivate CTRLCU

@enduml
