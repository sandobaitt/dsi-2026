@startuml plantilla_secuencia
!pragma layout smetana
autonumber "<b>[00]</b>"
skinparam shadowing false
skinparam roundcorner 8
skinparam sequenceArrowThickness 1.5
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

' ==============================================================================
' PLANTILLA: Diagrama de Secuencia (Cátedra DSI 2026)
' - Orden: Actor -> UI -> CTRLCU -> CTRLSesion -> Sistema -> Dominio -> Actor Externo
' - Servicios externos tratados directamente como ACTORES EXTERNOS
' - CTRLSesion preexistente para credenciales (sin pedir datos conocidos al actor)
' - Creación de listas temporales exclusiva por Sistema, sin destroy, sin return
' ==============================================================================

' ------------------------------------------------------------------------------
' 1. PARTICIPANTES Y ROLES
' ------------------------------------------------------------------------------
actor "Usuario" as Actor
boundary "PantallaOperacion" as UI <<Boundary>>
control "CTRLCasoDeUso" as CTRLCU <<Control>>
control "CTRLSesion" as CTRLSesion <<Control>>
participant "Sistema" as Sistema <<Sistema>>
collections "EntidadColeccion" as Entidades <<Entity>>
entity "listaTemp" as TempList <<Lista Temporal>>
actor "ServicioExterno" as ActorExt <<Actor Externo>>

' ------------------------------------------------------------------------------
' 2. MENSAJES Y FLUJO DE EVENTOS
' ------------------------------------------------------------------------------
Actor -> UI: 1. solicitarAccion()
activate UI

UI -> CTRLCU: 2. iniciarOperacion()
activate CTRLCU

' Consulta de sesión (preexistente)
CTRLCU -> CTRLSesion: 3. obtenerUsuarioLogueado()
activate CTRLSesion
CTRLSesion --> CTRLCU: 4. usuarioActivo
deactivate CTRLSesion

' Mensaje a Sistema: usa verbos de negocio como obtener...()
CTRLCU -> Sistema: 5. obtenerDatosRequeridos()
activate Sistema

' Creación de lista temporal por Sistema
create TempList
Sistema -> TempList: 6. create()

loop para cada entidad en Entidades
    ' Mensaje a Entidad: usa getters get...()
    Sistema -> Entidades: 7. getAtributo()
    activate Entidades
    Entidades --> Sistema: 8. valor
    deactivate Entidades

    Sistema -> TempList: 9. add(valor)
end

' Retorno hacia el controlador (sin palabra return, sin retorno desde lista)
Sistema --> CTRLCU: 10. listaTemp
deactivate Sistema

CTRLCU --> UI: 11. solicitarConfirmacion(listaTemp)
deactivate CTRLCU

Actor -> UI: 12. ingresarDatosYConfirmar()
UI -> CTRLCU: 13. confirmarOperacion()
activate CTRLCU

' Regla de Cátedra: Comunicación con servicio externo hacia ACTOR EXTERNO
CTRLCU -> ActorExt: 14. validarConTercero(datos)
activate ActorExt
ActorExt --> CTRLCU: 15. resultadoValidacion (ok)
deactivate ActorExt

alt Resultado Exitoso
    CTRLCU -> Sistema: 16. registrarOperacion()
    activate Sistema
    Sistema --> CTRLCU: 17. confirmacion
    deactivate Sistema

    CTRLCU --> UI: 18. mostrarConfirmacion()
    UI --> Actor: 19. Despliega comprobante exitoso
else Resultado Rechazado
    CTRLCU --> UI: 18a. mostrarError(motivo)
    UI --> Actor: 19a. Informa el motivo del rechazo
end

deactivate CTRLCU
deactivate UI

@enduml
