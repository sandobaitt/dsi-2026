@startuml plantilla_diagrama_clases
!pragma layout smetana
skinparam shadowing false
skinparam roundcorner 8
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ==============================================================================
' PLANTILLA: Diagrama de Clases (Realización del CU - Cátedra DSI 2026)
' - Se grafican ÚNICAMENTE las clases involucradas en el caso de uso.
' - REGLA DE ORO DE CÁTEDRA: Las clases UI y Controlador NO LLEVAN ATRIBUTOS.
' - Las clases de dominio SÍ contienen atributos y métodos.
' - Todo mensaje recibido en el Diagrama de Secuencia DEBE ser método aquí.
' ==============================================================================

package "Capa de Presentación y Control" {
    
    ' UI: Sin atributos. Responsable de interacción con el actor.
    class "PantallaOperacion" as UI <<Boundary>> {
        + mostrarDatos(lista: List): void
        + solicitarDatos(): void
        + mostrarConfirmacion(): void
        + mostrarError(mensaje: String): void
    }

    ' Controlador: Sin atributos. Coordina el flujo del CU.
    class "CTRLCasoDeUso" as CTRLCU <<Control>> {
        + iniciarOperacion(): void
        + procesarSeleccion(id: int): void
        + confirmarOperacion(): void
    }

    ' Controlador de Sesión: Sin atributos. Provee credenciales del usuario activo.
    class "CTRLSesion" as CTRLSesion <<Control>> {
        + obtenerUsuarioLogueado(): Usuario
        + obtenerLegajo(): String
    }

    ' Sistema: Fachada global. Conoce colecciones, busca, da de alta y calcula.
    class "Sistema" as Sistema <<Sistema>> {
        + obtenerEntidadesDisponibles(): List
        + verificarCondicion(): boolean
        + registrarTransaccion(): void
    }
}

package "Capa de Dominio" {
    
    class "EntidadA" as EntidadA <<Entity>> {
        - id: int
        - estado: String
        + getId(): int
        + estaActivo(): boolean
    }

    class "EntidadB" as EntidadB <<Entity>> {
        - codigo: String
        - importe: double
        + getImporte(): double
    }

    ' Clase asociativa / transacción que relaciona a las entidades del dominio
    class "Transaccion" as Transaccion <<Entity>> {
        - nroTransaccion: int
        - fecha: Date
        - montoTotal: double
        + calcularTotal(): double
        + confirmar(): void
    }

    class "DetalleTransaccion" as Detalle <<Entity>> {
        - cantidad: int
        - precioHistorico: double
        + calcularSubtotal(): double
    }
}

' ------------------------------------------------------------------------------
' RELACIONES
' ------------------------------------------------------------------------------

' Flujo de Control y Dependencias
UI ..> CTRLCU : invoca
CTRLCU --> CTRLSesion : consulta sesión
CTRLCU --> Sistema : delega operaciones

' Sistema administra colecciones
Sistema o-- "*" Transaccion : administra
Sistema o-- "*" EntidadA : busca en

' Relaciones estructurales del Dominio
EntidadA "1" -- "*" Transaccion : participa en >
Transaccion "1" *-- "1..*" Detalle : compuesta por >
Detalle "*" --> "1" EntidadB : referencia a >

@enduml
