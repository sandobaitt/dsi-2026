@startuml clases_gestion_pedidos
!pragma layout smetana
skinparam shadowing false
skinparam roundcorner 8
skinparam classAttributeIconSize 0
skinparam linetype ortho

' ==============================================================================
' EJEMPLO: Diagrama de Clases - Realización de CU-03 Crear Pedido
' Materia: Diseño de Sistemas (DSI 2026)
' - Se incluyen ÚNICAMENTE las clases involucradas en el caso de uso.
' - REGLA DE CÁTEDRA: UI y Controlador NO TIENEN ATRIBUTOS.
' - Coherencia total: Todo mensaje de secuencia es método aquí.
' ==============================================================================

package "Capa de Presentación y Control" {
    
    ' UI: Sin atributos
    class "PantallaCarrito" as UI <<Boundary>> {
        + mostrarDatosEntregaYPago(): void
        + mostrarPantallaExito(idPedido: int): void
        + mostrarMensajeError(mensaje: String): void
    }

    ' Controlador del CU: Sin atributos
    class "ControladorPedido" as CTRLCU <<Control>> {
        + iniciarCreacionPedido(idCarrito: int): void
        + confirmarPedido(datosTarjeta: String, direccion: String): void
    }

    ' Controlador de Sesión: Sin atributos
    class "ControladorSesion" as CTRLSesion <<Control>> {
        + obtenerUsuarioLogueado(): Cliente
        + obtenerLegajo(): String
    }

    ' Sistema: Fachada de negocio. Conoce colecciones y busca.
    class "Sistema" as Sistema <<Sistema>> {
        + obtenerItemsCarrito(idCarrito: int): List
        + verificarStock(idProducto: int, cantidad: int): boolean
        + decrementarStock(idProducto: int, cantidad: int): void
        + registrarPedido(cliente: Cliente, direccion: String): int
    }
}

package "Capa de Dominio" {
    
    class "Cliente" as Cliente <<Entity>> {
        - idCliente: int
        - nombre: String
        - email: String
        - direccion: String
        + getIdCliente(): int
        + getNombre(): String
        + getDireccion(): String
    }

    ' Clase transaccional que relaciona Cliente, Producto (vía Detalle) y Factura
    class "Pedido" as Pedido <<Entity>> {
        - nroPedido: int
        - fechaCreacion: DateTime
        - estado: String
        - montoTotal: double
        - direccionEntrega: String
        + calcularTotal(): double
        + confirmarPago(): void
        + cancelar(): void
        + getNroPedido(): int
    }

    class "DetallePedido" as DetallePedido <<Entity>> {
        - cantidad: int
        - precioUnitarioHistorico: double
        + calcularSubtotal(): double
        + getCantidad(): int
        + getPrecioUnitario(): double
    }

    class "Producto" as Producto <<Entity>> {
        - idProducto: int
        - nombre: String
        - precioActual: double
        - stockActual: int
        + getIdProducto(): int
        + getPrecioActual(): double
        + getStockActual(): int
        + tieneStockSuficiente(cantidad: int): boolean
        + decrementarStock(cantidad: int): void
    }

    class "Factura" as Factura <<Entity>> {
        - nroComprobante: String
        - fechaEmision: DateTime
        - importeTotal: double
        + emitir(): void
    }
}

' ------------------------------------------------------------------------------
' RELACIONES
' ------------------------------------------------------------------------------

' Flujo de control
UI ..> CTRLCU : invoca
CTRLCU --> CTRLSesion : consulta sesión
CTRLCU --> Sistema : delega operaciones

' Sistema conoce colecciones globales de entidades
Sistema o-- "*" Pedido : pedidosRegistrados
Sistema o-- "*" Producto : catalogoProductos

' Relaciones estructurales del Dominio
Cliente "1" -- "*" Pedido : realiza >
Pedido "1" *-- "1..*" DetallePedido : contiene >
DetallePedido "*" --> "1" Producto : referencia a >
Pedido "1" -- "0..1" Factura : genera >

note bottom of Pedido
  **Clase Transaccional:**
  Relaciona al Cliente con los
  Productos (vía Detalle) y la Factura.
end note

@enduml
